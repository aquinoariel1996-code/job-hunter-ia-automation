              "type": "string"
            },
            {
              "id": "36422bad-8340-453b-8add-fcb2bf6c84a6",
              "name": "Resumen consolidado",
              "value": "={{ (() => {   const r = $json.output ?? $json.text ?? $json;   const v = typeof r === \"string\" ? JSON.parse(r) : r;    return \"Asunto principal: \" + v.asunto_principal +     \"\\nPuntos clave:\\n- \" +     v.puntos_clave.join(\"\\n- \") +     \"\\nAcción requerida: \" + v.accion_requerida; })() }}",
              "type": "string"
            },
            {
              "id": "f4bda41f-2061-468a-9657-5e26edb0455d",
              "name": "Estado del caso",
              "value": "={{ $('MEMORIA - Preparar actualización').first().json[\"Estado del caso\"] }}",
              "type": "string"
            },
            {
              "id": "37a48f79-79ec-4a9b-b918-cac2590c4b0d",
              "name": "Datos clave",
              "value": "={{ (() => {   const base = JSON.parse(     $('MEMORIA - Preparar actualización').first().json[\"Datos clave\"] || \"{}\"   );    const r = $json.output ?? $json.text ?? $json;   const v = typeof r === \"string\" ? JSON.parse(r) : r;    base.datos_relevantes = [     ...new Set([       ...(base.datos_relevantes || []),       ...v.puntos_clave     ])   ];    base.ultimo_asunto = v.asunto_principal;   base.accion_requerida = v.accion_requerida;   base.mensajes_pendientes = [];    return JSON.stringify(base); })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
