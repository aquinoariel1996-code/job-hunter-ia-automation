              "id": "4cc0dabd-05b1-4205-89ce-f1abdf606cfd",
              "name": "Datos clave",
              "value": "=\n{{ (() => {\n  let datos;\n\n  try {\n    datos = JSON.parse($json[\"Datos clave\"] || \"{}\");\n  } catch (error) {\n    datos = {};\n  }\n\n  datos.contador_mensajes =\n    (Number(datos.contador_mensajes) || 0) + 1;\n\n  if (!Array.isArray(datos.datos_relevantes)) {\n    datos.datos_relevantes = [];\n  }\n\n  if (!Array.isArray(datos.mensajes_pendientes)) {\n    datos.mensajes_pendientes = [];\n  }\n\n  const mensaje = String(\n    $('When Executed by Another Workflow').first().json.mensaje || \"\"\n  ).trim();\n\n  if (mensaje) {\n    datos.mensajes_pendientes.push(mensaje);\n  }\n\n  return JSON.stringify(datos);\n})() }}",
              "type": "string"
            },
