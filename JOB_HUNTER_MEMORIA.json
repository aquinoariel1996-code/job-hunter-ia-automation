        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"asunto_principal\": {\n      \"type\": \"string\"\n    },\n    \"puntos_clave\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"accion_requerida\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"asunto_principal\",\n    \"puntos_clave\",\n    \"accion_requerida\"\n  ],\n  \"additionalProperties\": false\n}"
      },
