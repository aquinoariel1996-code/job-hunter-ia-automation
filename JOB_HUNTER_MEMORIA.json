              "name": "Session_ID",
              "value": "={{ String($('MEMORIA - Preparar actualización').first().json.Session_ID).trim() }}",
              "type": "string"
            },
            {
              "id": "e0324afc-2506-43f7-82f7-e1cfd89c03cd",
